@page "{id:int}"
@model ToDoSommarProjekt.Pages.ToDo.EditModel
@{
    ViewData["Title"] = "Redigera todo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-4">Redigera todo</h1>

            <form method="post">
                <input type="hidden" asp-for="ToDoItem.Id" />

                <div class="mb-3">
                    <label asp-for="ToDoItem.Title" class="form-label"></label>
                    <input asp-for="ToDoItem.Title" class="form-control" />
                    <span asp-validation-for="ToDoItem.Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ToDoItem.Deadline" class="form-label"></label>
                    <input asp-for="ToDoItem.Deadline" class="form-control" type="date" />
                    <span asp-validation-for="ToDoItem.Deadline" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ToDoItem.CategoryId" class="form-label"></label>
                    <select asp-for="ToDoItem.CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">-- Välj kategori --</option>
                    </select>
                    <span asp-validation-for="ToDoItem.CategoryId" class="text-danger"></span>
                    <a asp-page="/CategoriesPages/Create" asp-route-returnUrl="/ToDo/Edit/@Model.ToDoItem.Id" class="text-muted small">Hantera kategorier</a>
                </div>
                <div class="mb-3">
                    <label asp-for="ToDoItem.Info" class="form-label">Mer information</label>
                    <textarea asp-for="ToDoItem.Info" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="ToDoItem.Info" class="text-danger"></span>
                </div>


                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Spara</button>
                    <a asp-page="/Index" class="btn btn-outline-secondary">Avbryt</a>
                </div>
            </form>
        </div>
    </div>
</div>