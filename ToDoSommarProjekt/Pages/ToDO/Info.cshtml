@page "{id:int}"
@model ToDoSommarProjekt.Pages.ToDO.InfoModel
@{
    ViewData["Title"] = Model.ToDoItem!.Title;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h4 mb-0">@Model.ToDoItem.Title</h2>
                @if (Model.ToDoItem.IsCompleted)
                {
                    <span class="badge text-bg-success">Klar</span>
                }
                else if (Model.ToDoItem.Deadline < DateOnly.FromDateTime(DateTime.Now))
                {
                    <span class="badge text-bg-danger">Försenad</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Pågående</span>
                }
            </div>

            <div class="card-body">
                <dl class="row mb-4">
                    <dt class="col-sm-4">Kategori</dt>
                    <dd class="col-sm-8">@(Model.ToDoItem.Category?.Name ?? "Ingen kategori")</dd>

                    <dt class="col-sm-4">Deadline</dt>
                    <dd class="col-sm-8">@Model.ToDoItem.Deadline</dd>
                </dl>

                <h3 class="h6 text-muted text-uppercase">Mer information</h3>
                <p class="mb-0" style="white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.ToDoItem.Info) ? "Ingen extra information." : Model.ToDoItem.Info)
                </p>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a asp-page="/Index" class="btn btn-outline-secondary">Tillbaka</a>
                <a asp-page="/ToDo/Edit" asp-route-id="@Model.ToDoItem.Id" class="btn btn-outline-primary">Redigera</a>
            </div>
        </div>
    </div>
</div>