@page
@model ToDoSommarProjekt.Pages.IndexModel
@{
    ViewData["Title"] = "Mina ToDos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mina ToDo's</h1>
        <a asp-page="/ToDo/Create" class="btn btn-primary">+ Skapa ny ToDo</a>
    </div>


    <form method="get" class="mb-3">
        <input type="hidden" name="VisaKlara" id="VisaKlaraHidden" value="@Model.VisaKlara.ToString().ToLower()" />
        <input type="hidden" name="VisaEjKlara" id="VisaEjKlaraHidden" value="@Model.VisaEjKlara.ToString().ToLower()" />
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="VisaKlaraCheck" @(Model.VisaKlara ? "checked" : "") />
            <label class="form-check-label" for="VisaKlaraCheck">Visa klara</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="VisaEjKlaraCheck" @(Model.VisaEjKlara ? "checked" : "") />
            <label class="form-check-label" for="VisaEjKlaraCheck">Visa ej klara</label>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Titel</th>
                <th>Kategori</th>
                <th>Deadline</th>
                <th>Klar</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ToDoItems)
            {
                <tr class="@(item.IsCompleted ? "table-success" : item.Deadline < DateOnly.FromDateTime(DateTime.Now) ? "table-danger" : "")">
                    <td>@item.Title</td>
                    <td>@item.Category?.Name</td>
                    <td>@item.Deadline</td>
                    <td>
                        <form method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input class="form-check-input" type="checkbox"
                                   asp-page-handler="Toggle"
                                   onchange="this.form.submit()"
                            @(item.IsCompleted ? "checked" : "") />
                        </form>
                    </td>
                    <td>
                        <a asp-page="/ToDo/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Redigera</a>
                        <a asp-page="/ToDo/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Radera</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/todo.js"></script>
}