@page
@model ToDoSommarProjekt.Pages.IndexModel
@{
    ViewData["Title"] = "Mina todos";
}

<h1>Mina todos</h1>

<a asp-page="/Create">Skapa ny todo</a>

<table>
    <thead>
        <tr>
            <th>Titel</th>
            <th>Kategori</th>
            <th>Klar</th>
            <th>Deadline</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ToDoItems)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Category?.Name</td>
                <td>@item.IsCompleted</td>
                <td>@item.Deadline</td>
                <td>
                    <a asp-page="/Edit" asp-route-id="@item.Id">Redigera</a>
                </td>
            </tr>
        }
    </tbody>
</table>