@page
@model ToDoSommarProjekt.Pages.IndexModel
@{
    ViewData["Title"] = "Mina ToDos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mina ToDo's</h1>
        <a asp-page="/ToDo/Create" class="btn btn-primary">+ Skapa ny ToDo</a>
    </div>


    <form method="get" class="mb-3">
        <input type="hidden" name="VisaKlara" id="VisaKlaraHidden" value="@Model.VisaKlara.ToString().ToLower()" />
        <input type="hidden" name="VisaEjKlara" id="VisaEjKlaraHidden" value="@Model.VisaEjKlara.ToString().ToLower()" />
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="VisaKlaraCheck" @(Model.VisaKlara ? "checked" : "") />
            <label class="form-check-label" for="VisaKlaraCheck">Visa klara</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="VisaEjKlaraCheck" @(Model.VisaEjKlara ? "checked" : "") />
            <label class="form-check-label" for="VisaEjKlaraCheck">Visa ej klara</label>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Titel</th>
                <th>Kategori</th>
                <th>Deadline</th>
                <th>Klar</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ToDoItems)
            {
                <tr class="position-relative @(item.IsCompleted ? "table-success" : item.Deadline < DateOnly.FromDateTime(DateTime.Now) ? "table-danger" : "")">
                    <td><a asp-page="/ToDo/Info" asp-route-id="@item.Id" class="stretched-link text-decoration-none text-body">@item.Title</a></td>
                    <td>@item.Category?.Name</td>
                    <td>@item.Deadline</td>
                    <td class="position-relative z-1">
                        <form method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input class="form-check-input" type="checkbox"
                                   asp-page-handler="Toggle"
                                   onchange="this.form.submit()"
                            @(item.IsCompleted ? "checked" : "") />
                        </form>
                    </td>
                    <td class ="position-relative z-1">
                        <a asp-page="/ToDo/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Redigera</a>
                        <a asp-page="/ToDo/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Radera</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Index"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-VisaKlara="@Model.VisaKlara"
                       asp-route-VisaEjKlara="@Model.VisaEjKlara">Föregående</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-page="/Index"
                           asp-route-pageNumber="@i"
                           asp-route-VisaKlara="@Model.VisaKlara"
                           asp-route-VisaEjKlara="@Model.VisaEjKlara">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="/Index"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-VisaKlara="@Model.VisaKlara"
                       asp-route-VisaEjKlara="@Model.VisaEjKlara">Nästa</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script src="~/js/todo.js"></script>
}