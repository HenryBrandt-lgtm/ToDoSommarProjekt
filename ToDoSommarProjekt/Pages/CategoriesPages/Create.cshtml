@page
@model ToDoSommarProjekt.Pages.CategoriesPages.CreateModel
@{
    ViewData["Title"] = "Skapa Kategori";

}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-4">Skapa ny Kategori</h1>

            <form method="post">
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label"></label>
                    <input asp-for="Category.Name" class="form-control" />
                    <span asp-validation-for="Category.Name" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Spara</button>
                    <a asp-page="/CategoriesPages/Index" class="btn btn-outline-secondary">Avbryt</a>
                </div>
            </form>
        </div>
    </div>
</div>