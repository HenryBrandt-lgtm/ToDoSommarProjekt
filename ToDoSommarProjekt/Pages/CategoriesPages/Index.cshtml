@page
@model ToDoSommarProjekt.Pages.CategoriesPages.IndexModel
@{
    ViewData["Title"] = "Mina Kategorier";

}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mina Kategorier</h1>
        <a asp-page="/CategoriesPages/Create" class="btn btn-primary">+ Skapa ny Kategori</a>
    </div>


<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>

            <th>Kategori</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Categories)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-page="/CategoriesPages/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Redigera</a>
                    <a asp-page="/CategoriesPages/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Radera</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>